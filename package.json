{
  "name": "epub-tts",
  "private": true,
  "version": "1.0.0-rc.0",
  "license": "GPL-3.0-only",
  "description": "EPUB reader that reads chapters aloud with Piper TTS in the browser, streamed in segments.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "coi-serviceworker": "0.1.7",
    "epubjs": "0.3.93",
    "onnxruntime-web": "1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "jszip": "^3.10.2",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^3.1.0"
  }
}
